// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum TrendSource {
  SEED
  YOUTUBE
  TIKTOK
  INSTAGRAM
}

enum ActivityType {
  TREND_CHECK
  IDEA_SAVED
  POST_CHECK
  BENCHMARK
}

enum Persona {
  GENKI // 元気印
  COOL // クール
  HONWAKA // ほんわか
  DOKUZETSU // 毒舌気味
  SEITOHA // 正統派
}

// タレント本人のアカウント。企画・活動履歴はユーザーごとに分離される。
// トレンド(Trend)はユーザーに紐付かない共有データのまま。
model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  displayName  String
  createdAt    DateTime @default(now())

  ideas             Idea[]
  activities        Activity[]
  playbookFavorites PlaybookFavorite[]
}

// トレンド情報。SEED=初期投入データ、YOUTUBE=YouTube Data APIから同期。
// TikTok/Instagramは公式APIの審査が下り次第、同じテーブルにsource値を追加して連携する想定。
model Trend {
  id            String      @id @default(uuid())
  category      String
  name          String
  description   String
  whyHot        String
  howToUse      String
  growth        String
  thumbnailFrom String
  thumbnailTo   String
  source        TrendSource @default(SEED)
  sourceLabel   String? // 例: チャンネル名、投稿者名（＝参考にできる投稿者）
  sourceUrl     String? // 参考リンク（実データ取得時のみ。ダミーデータでは捏造しない）
  artistName    String? // 音源カテゴリの場合の歌手・アーティスト名
  songTitle     String? // 音源カテゴリの場合の曲名
  searchKeywords String[] @default([]) // このトレンドの参考動画を探すための検索キーワード・ハッシュタグ案
  videoAnalysis String? // Geminiが実際に動画を見て分析した、画角・カット割り・編集のポイント（YOUTUBE実データのみ）
  fetchedAt     DateTime    @default(now())

  ideas Idea[]

  @@index([category])
}

// カテゴリー・週ごとの「今伸びている動画」ランキング（最大5件）。
// Trend（カテゴリー代表の1件）とは別に、週替わりで上書きせず週ごとの記録として蓄積する。
// source系（YOUTUBE実データ）はsourceUrlが入り、SEEDのダミーデータはsourceUrlをnullのままにする
// （実際に存在しないリンクを捏造しないため）。
model TrendRanking {
  id           String   @id @default(uuid())
  category     String
  weekOf       DateTime // 集計対象週の開始日（月曜0時, UTC基準で丸めた値）
  rank         Int // 1〜5、カテゴリー・週内の順位（1が最上位）
  title        String
  channelTitle String
  channelUrl   String? // チャンネルページへのリンク（取得できた場合のみ）
  artistName   String? // 音源カテゴリでAIが読み取れた場合のみ設定
  songTitle    String?
  viewCount    Int
  growth       String // 表示用（例: "12.3万回再生"）
  thumbnailUrl String?
  sourceUrl    String?
  publishedAt  DateTime
  fetchedAt    DateTime @default(now())

  @@unique([category, weekOf, rank])
  @@index([category, weekOf])
}

// 音源トレンドの週間ランキング。Trend/TrendRankingとは独立した専用テーブル。
// 曲名・アーティスト名・YouTubeリンク（MVまたは音源）・主な使用用途（踊ってみた／ネタ系／
// Vlog系／その他）を実データ（YouTube Data API）から構成する。TREND側の「音源」カテゴリーは
// 廃止し、こちらの専用ランキングに一本化した。
// 用途ごとに独立したランキング（各最大20件）として保存する（rankは用途内での週内順位）。
model SongRanking {
  id           String   @id @default(uuid())
  weekOf       DateTime // 集計対象週の開始日（月曜0時, UTC基準で丸めた値）
  usageType    String // 主な使用用途（踊ってみた／ネタ系／Vlog系／その他）
  rank         Int // 1〜20、用途内・週内の順位（1が最上位）
  songTitle    String
  artistName   String
  youtubeUrl   String // MVまたは音源のYouTubeリンク（複数候補中、最も再生数が多かった動画）
  thumbnailUrl String?
  viewCount    Int // 上記代表動画の再生数（参考値）
  usageCount   Int      @default(1) // この同期で検索・分析した動画のうち、同じ曲だと判定された件数
  // （TikTok本体の「使用数」ではなく、あくまで今回検索して見つかった範囲内での出現数。
  // TikTok公式の使用数APIは一般開発者に提供されていないため代用している）
  growth       String // 表示用（例: "12.3万回再生"）
  fetchedAt    DateTime @default(now())

  @@unique([weekOf, usageType, rank])
  @@index([weekOf])
}

// PLAYBOOK（ネタ集）のお気に入り。ネタ自体は固定データ（src/lib/playbook.ts）でDB行を
// 持たないため、userId + playbookIdeaId（PlaybookIdea.idと同じ文字列）の組でお気に入り
// 状態だけを記録する中間テーブル。
model PlaybookFavorite {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  playbookIdeaId String // src/lib/playbook.ts の PlaybookIdea.id
  createdAt      DateTime @default(now())

  @@unique([userId, playbookIdeaId])
  @@index([userId])
}

// AIが生成した投稿企画。generatedByAIがtrueのものはGemini生成、falseは初期シードデータ。
// userIdで所有者を分離し、他のタレントの企画が見えないようにする。
model Idea {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  trendId       String? // トレンドを使わず、ユーザー自身の指示だけで生成した企画はnull
  trend         Trend?   @relation(fields: [trendId], references: [id], onDelete: Cascade)
  customPrompt  String? // trendIdがnullの場合、生成のもとになったユーザー自身の指示文
  persona       Persona?
  title         String
  reason        String
  opening       String
  location      String
  expression    String
  structure     String
  duration      String
  punchline     String
  saved         Boolean  @default(false)
  generatedByAI Boolean  @default(false)
  createdAt     DateTime @default(now())

  @@index([userId])
  @@index([saved])
  @@index([createdAt])
}

// MY REPORTの活動ログ・カウントの元データ。userIdで所有者を分離する。
model Activity {
  id        String       @id @default(uuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      ActivityType
  text      String
  createdAt DateTime     @default(now())

  @@index([userId])
  @@index([type])
  @@index([createdAt])
}
